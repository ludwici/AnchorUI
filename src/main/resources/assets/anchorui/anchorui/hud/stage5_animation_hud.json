{
  "testOnly": true,
  "testGroup": "animation",
  "style": "anchorui:style/rpg_progress",
  "entities": [
    {
      "type": "anchorui:text",
      "id": "anchorui:animation_hud_title",
      "text": "<b>ANIMATED HUD</b>",
      "align": "left",
      "color": "#FFF0D1A5",
      "position": {
        "point": "TOPRIGHT",
        "anchor": "TOPRIGHT",
        "relativeTo": "screen",
        "x": -18,
        "y": 32
      },
      "size": {
        "width": 180,
        "height": 18
      },
      "animation": {
        "open": {
          "duration": 550,
          "easing": "easeOut",
          "opacity": [
            0,
            1
          ],
          "x": [
            60,
            0
          ]
        }
      }
    },
    {
      "type": "anchorui:progress",
      "id": "anchorui:animation_hud_health",
      "position": {
        "point": "TOPLEFT",
        "anchor": "BOTTOMLEFT",
        "relativeTo": "anchorui:animation_hud_title",
        "x": 0,
        "y": 4
      },
      "size": {
        "width": 180,
        "height": 16
      },
      "fillColor": "#D95565",
      "value": {
        "bind": "anchorui:player.health",
        "fallback": 0
      },
      "max": {
        "bind": "anchorui:player.max_health",
        "fallback": 20
      },
      "showText": true,
      "animation": {
        "open": {
          "duration": 650,
          "easing": "outCubic",
          "opacity": [
            0,
            1
          ],
          "x": [
            40,
            0
          ]
        },
        "watch": {
          "bind": "anchorui:player.health",
          "fallback": 20
        },
        "change": {
          "duration": 360,
          "easing": "easeOut",
          "scale": [
            1.1,
            1
          ]
        }
      }
    },
    {
      "type": "anchorui:progress",
      "id": "anchorui:animation_hud_food",
      "position": {
        "point": "TOPLEFT",
        "anchor": "BOTTOMLEFT",
        "relativeTo": "anchorui:animation_hud_health",
        "x": 0,
        "y": 5
      },
      "size": {
        "width": 180,
        "height": 16
      },
      "fillColor": "#D59D4A",
      "value": {
        "bind": "anchorui:player.food",
        "fallback": 0
      },
      "max": 20,
      "showText": true,
      "animation": {
        "open": {
          "duration": 760,
          "easing": "easeOut",
          "opacity": [
            0,
            1
          ],
          "y": [
            15,
            0
          ]
        }
      }
    }
  ]
}

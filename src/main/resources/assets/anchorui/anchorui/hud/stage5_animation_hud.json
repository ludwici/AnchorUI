{
  "testOnly": true,
  "testGroup": "animation",
  "style": "anchorui:style/rpg_progress",
  "entities": [
    {
      "type": "anchorui:text",
      "id": "anchorui:animation_hud_title",
      "text": "<b>ANIMATED HUD</b>",
      "align": "left",
      "color": "#FFF0D1A5",
      "position": {
        "point": "TOPRIGHT",
        "anchor": "TOPRIGHT",
        "relativeTo": "screen",
        "x": -18,
        "y": 32
      },
      "size": {
        "width": 180,
        "height": 18
      },
      "animations": [
        {
          "id": "open_effect",
          "trigger": "open",
          "duration": 550,
          "easing": "easeOut",
          "from": {
            "opacity": 0,
            "x": 60
          },
          "to": {
            "opacity": 1,
            "x": 0
          }
        }
      ]
    },
    {
      "type": "anchorui:progress",
      "id": "anchorui:animation_hud_health",
      "position": {
        "point": "TOPLEFT",
        "anchor": "BOTTOMLEFT",
        "relativeTo": "anchorui:animation_hud_title",
        "x": 0,
        "y": 4
      },
      "size": {
        "width": 180,
        "height": 16
      },
      "fillColor": "#D95565",
      "value": {
        "bind": "anchorui:player.health",
        "fallback": 0
      },
      "max": {
        "bind": "anchorui:player.max_health",
        "fallback": 20
      },
      "showText": true,
      "animations": [
        {
          "id": "entrance_fade",
          "trigger": "open",
          "duration": 650,
          "easing": "outCubic",
          "from": {
            "opacity": 0
          },
          "to": {
            "opacity": 1
          }
        },
        {
          "id": "entrance_motion",
          "trigger": "open",
          "duration": 750,
          "delay": 180,
          "easing": "outCubic",
          "from": {
            "x": 40
          },
          "to": {
            "x": 0
          }
        },
        {
          "id": "change_effect",
          "trigger": "change",
          "duration": 360,
          "easing": "easeOut",
          "from": {
            "scale": 1.1
          },
          "to": {
            "scale": 1
          },
          "watch": {
            "bind": "anchorui:player.health",
            "fallback": 20
          }
        }
      ],
      "sizeTransition": {
        "duration": 420,
        "easing": "easeOut"
      }
    },
    {
      "type": "anchorui:progress",
      "id": "anchorui:animation_hud_food",
      "position": {
        "point": "TOPLEFT",
        "anchor": "BOTTOMLEFT",
        "relativeTo": "anchorui:animation_hud_health",
        "x": 0,
        "y": 5
      },
      "size": {
        "width": 180,
        "height": 16
      },
      "fillColor": "#D59D4A",
      "value": {
        "bind": "anchorui:player.food",
        "fallback": 0
      },
      "max": 20,
      "showText": true,
      "animations": [
        {
          "id": "open_effect",
          "trigger": "open",
          "duration": 760,
          "easing": "easeOut",
          "from": {
            "opacity": 0,
            "y": 15
          },
          "to": {
            "opacity": 1,
            "y": 0
          }
        }
      ],
      "sizeTransition": {
        "duration": 420,
        "easing": "easeOut"
      }
    }
  ]
}

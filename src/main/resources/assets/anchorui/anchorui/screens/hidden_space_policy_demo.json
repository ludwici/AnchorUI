            "width": 112,
            "height": 25
          }
        },
        {
          "type": "anchorui:button",
          "id": "anchorui:reserve_panel_middle",
          "text": "Conditional middle",
          "size": {
            "width": 112,
            "height": 25
          },
          "visibleWhen": {
            "not": {
              "bind": "anchorui:ui.state",
              "path": "hideMiddle",
              "fallback": false
            }
          }
        },
        {
          "type": "anchorui:button",
          "id": "anchorui:reserve_panel_last",
          "text": "Last item",
          "size": {
            "width": 112,
            "height": 25
          }
        }
      ]
    },
    {
      "type": "anchorui:panel",
      "id": "anchorui:collapse_panel",
      "text": "",

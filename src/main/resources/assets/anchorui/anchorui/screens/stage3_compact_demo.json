{
  "style": "anchorui:style/textured_controls",
  "state": {
    "showInfo": true,
    "choice": "normal"
  },
  "entities": [
    {
      "type": "anchorui:text",
      "id": "anchorui:compact_title",
      "text": "<b>INPUT / SKIN QA</b>",
      "position": {
        "point": "CENTER",
        "anchor": "CENTER",
        "relativeTo": "screen",
        "x": 0,
        "y": -91
      },
      "size": {
        "width": 250,
        "height": 18
      },
      "align": "center",
      "color": "#A0E8F5FF"
    },
    {
      "type": "anchorui:panel",
      "id": "anchorui:compact_panel",
      "position": {
        "point": "CENTER",
        "anchor": "CENTER",
        "relativeTo": "screen",
        "x": 0,
        "y": -10
      },
      "size": {
        "width": 244,
        "height": 104
      },
      "padding": {
        "left": 8,
        "right": 8,
        "top": 8,
        "bottom": 8
      },
      "clipChildren": true,
      "fillColor": "#DA182E40",
      "borderColor": "#FFC3D9E7",
      "borderWidth": 1,
      "layout": {
        "type": "column",
        "gap": 6
      },
      "children": [
        {
          "type": "anchorui:checkbox",
          "id": "anchorui:compact_checkbox",
          "text": "Show selection",
          "stateKey": "showInfo",
          "size": {
            "width": 224,
            "height": 22
          },
          "onChange": "anchorui_test:event_notice"
        },
        {
          "type": "anchorui:select",
          "id": "anchorui:compact_select",
          "text": "Quality",
          "stateKey": "choice",
          "size": {
            "width": 224,
            "height": 22
          },
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "high",
              "label": "High",
              "style": "anchorui:rare_option"
            },
            {
              "value": "ultra",
              "label": "Ultra"
            }
          ],
          "onChange": "anchorui_test:event_notice"
        },
        {
          "type": "anchorui:button",
          "id": "anchorui:compact_close",
          "text": "Close",
          "size": {
            "width": 100,
            "height": 20
          },
          "onClick": "anchorui:close_screen"
        }
      ]
    },
    {
      "type": "anchorui:text",
      "id": "anchorui:compact_value",
      "text": "Choice: {{anchorui:ui.state#choice}}",
      "position": {
        "point": "CENTER",
        "anchor": "CENTER",
        "relativeTo": "screen",
        "x": 0,
        "y": 69
      },
      "size": {
        "width": 245,
        "height": 20
      },
      "align": "center",
      "visibleWhen": {
        "bind": "anchorui:ui.state",
        "path": "showInfo",
        "fallback": false
      }
    },
    {
      "type": "anchorui:text",
      "id": "anchorui:compact_hint",
      "text": "Tab / Shift+Tab, Esc, F8, F3+T",
      "position": {
        "point": "CENTER",
        "anchor": "CENTER",
        "relativeTo": "screen",
        "x": 0,
        "y": 92
      },
      "size": {
        "width": 258,
        "height": 18
      },
      "align": "center",
      "color": "#FFBECFDF"
    }
  ]
}
